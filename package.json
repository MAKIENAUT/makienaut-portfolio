{
  "name": "makienaut-monorepo",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.19"
  },
  "packageManager": "npm@9.2.0",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "test": "turbo test",
    "lint": "turbo lint",
    "dev:portfolio": "npm run dev --workspace=portfolio",
    "dev:vroombroom": "npm run dev --workspace=vroombroom",
    "dev:bonelessexpress": "npm run dev --workspace=bonelessexpress",
    "dev:bangusexpress": "npm run dev --workspace=bonelessexpress",
    "build:portfolio": "npm run build --workspace=portfolio",
    "build:vroombroom": "npm run build --workspace=vroombroom",
    "build:bonelessexpress": "npm run build --workspace=bonelessexpress",
    "build:bangusexpress": "npm run build --workspace=bonelessexpress",
    "test:vroombroom": "npm run test --workspace=vroombroom",
    "test:bonelessexpress": "npm run test --workspace=bonelessexpress",
    "test:bangusexpress": "npm run test --workspace=bonelessexpress",
    "postinstall": "npm run --workspaces --if-present postinstall"
  },
  "devDependencies": {
    "turbo": "^2.11.10"
  }
}
