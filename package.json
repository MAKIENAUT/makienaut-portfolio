{
  "name": "makienaut-portfolio",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "vercel-build": "prisma generate && prisma migrate deploy && next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:status": "prisma migrate status",
    "env:dev:pull": "npx --yes vercel env pull .env.local --environment=development --yes",
    "dev:setup": "npm run env:dev:pull && npm run db:deploy && npm run db:generate",
    "db:studio": "prisma studio",
    "auth:hash": "node scripts/hash-orb-password.mjs"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.9.0",
    "@prisma/client": "^7.9.0",
    "dotenv": "^17.4.2",
    "leaflet": "^1.9.4",
    "next": "15.5.21",
    "pg": "^8.22.0",
    "react": "19.1.9",
    "react-dom": "19.1.9",
    "react-icons": "^5.5.0"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.21",
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "@types/react": "19.1.17",
    "@types/react-dom": "19.1.11",
    "eslint": "^8",
    "eslint-config-next": "15.5.21",
    "postcss": "^8",
    "prisma": "^7.9.0",
    "tailwindcss": "^3.4.1",
    "typescript": "^5"
  }
}
