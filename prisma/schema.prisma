generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  IN_PROGRESS
  READY
  COMPLETED
  CANCELLED
}

enum BangusPaymentMethod {
  GCASH
  CASH
  BANK
}

enum OrbWeaverUserRole {
  ADMIN
  USER
}

model OrbWeaverUser {
  id           String             @id @default(uuid()) @db.Uuid
  username     String             @unique @db.VarChar(80)
  passwordHash String             @db.VarChar(256)
  role         OrbWeaverUserRole @default(USER)
  isActive     Boolean            @default(true)
  createdAt    DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime           @updatedAt @db.Timestamptz(3)

  @@index([role, isActive])
  @@map("orb_weaver_users")
}

model OrbWeaverAppointment {
  id                 String            @id @default(uuid()) @db.Uuid
  publicReference    String?           @unique @db.VarChar(16)
  customerName       String            @db.VarChar(100)
  email              String            @db.VarChar(160)
  phone              String            @db.VarChar(40)
  service            String            @db.VarChar(50)
  helmetCount        Int               @default(1)
  preferredDate      DateTime          @db.Date
  preferredWindow    String            @db.VarChar(30)
  handoffMethod      String?           @db.VarChar(30)
  handoffWindow      String?           @db.VarChar(80)
  completionWindow   String?           @db.VarChar(80)
  pickupArea         String?           @db.VarChar(180)
  pickupLatitude     Decimal?          @db.Decimal(9, 6)
  pickupLongitude    Decimal?          @db.Decimal(9, 6)
  requestedAddOns    Json?             @db.JsonB
  serviceUnitPrice   Int?
  addOnSubtotal      Int?
  estimatedSubtotal  Int?
  deliveryDistanceKm Decimal?          @db.Decimal(5, 2)
  deliveryFee        Int?
  deliveryProofUrl   String?           @db.VarChar(600)
  finalTotal         Int?
  deliveryPricedAt   DateTime?         @db.Timestamptz(3)
  notes              String?           @db.VarChar(1600)
  status             AppointmentStatus @default(PENDING)
  sourceFingerprint  String?           @db.VarChar(64)
  createdAt          DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime          @updatedAt @db.Timestamptz(3)

  @@index([status, preferredDate])
  @@index([sourceFingerprint, createdAt])
  @@map("orb_weaver_appointments")
}

model OrbWeaverLoginAttempt {
  id                BigInt   @id @default(autoincrement())
  sourceFingerprint String   @db.VarChar(64)
  createdAt         DateTime @default(now()) @db.Timestamptz(3)

  @@index([sourceFingerprint, createdAt])
  @@map("orb_weaver_login_attempts")
}

model BangusProductCategory {
  id        String          @id @default(uuid()) @db.Uuid
  name      String          @unique @db.VarChar(80)
  sortOrder Int             @default(0)
  createdAt DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt DateTime        @updatedAt @db.Timestamptz(3)
  products  BangusProduct[]

  @@index([sortOrder, name])
  @@map("bangus_product_categories")
}

model BangusProduct {
  id            String                @id @default(uuid()) @db.Uuid
  name          String                @db.VarChar(120)
  supplierPrice Int
  retailPrice   Int
  categoryId    String                @db.Uuid
  category      BangusProductCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  sizePack      String                @db.VarChar(60)
  flavor        String?               @db.VarChar(60)
  pieces        String?               @db.VarChar(60)
  isActive      Boolean               @default(true)
  sortOrder     Int                   @default(0)
  createdAt     DateTime              @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime              @updatedAt @db.Timestamptz(3)
  orderItems    BangusOrderItem[]

  @@index([isActive, sortOrder])
  @@index([categoryId, sortOrder])
  @@map("bangus_products")
}

model BangusDeliveryTable {
  id           String        @id @default(uuid()) @db.Uuid
  name         String        @db.VarChar(120)
  deliveryDate DateTime      @db.Date
  createdAt    DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime      @updatedAt @db.Timestamptz(3)
  orders       BangusOrder[]

  @@index([deliveryDate])
  @@map("bangus_delivery_tables")
}

model BangusOrder {
  id              String                @id @default(uuid()) @db.Uuid
  deliveryTableId String                @db.Uuid
  deliveryTable   BangusDeliveryTable   @relation(fields: [deliveryTableId], references: [id], onDelete: Cascade)
  customerName    String                @db.VarChar(120)
  repacked        Boolean               @default(false)
  received        Boolean               @default(false)
  paid            Boolean               @default(false)
  paymentMethod   BangusPaymentMethod?
  sortOrder       Int                   @default(0)
  createdAt       DateTime              @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime              @updatedAt @db.Timestamptz(3)
  items           BangusOrderItem[]

  @@index([deliveryTableId, sortOrder])
  @@map("bangus_orders")
}

model BangusOrderItem {
  id                String        @id @default(uuid()) @db.Uuid
  orderId           String        @db.Uuid
  order             BangusOrder   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId         String        @db.Uuid
  product           BangusProduct @relation(fields: [productId], references: [id], onDelete: Restrict)
  quantity          Int
  supplierUnitPrice Int
  retailUnitPrice   Int
  createdAt         DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime      @updatedAt @db.Timestamptz(3)

  @@unique([orderId, productId])
  @@index([productId])
  @@map("bangus_order_items")
}
