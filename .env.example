# VroomBroom development database
# The separate Prisma Postgres development resource supplies these values in
# Vercel Development. Run `npm run env:dev:pull` to create `.env.local`.
ORBW_DEV_DATABASE_URL="postgres://DEVELOPMENT_CONNECTION_STRING"
ORBW_DEV_POSTGRES_URL=""
ORBW_DEV_PRISMA_DATABASE_URL=""

# Deployed VroomBroom database
# The Vercel Prisma Postgres integration supplies these values. Configure them
# only for Preview/Production; local development prefers the URL above.
OW_MAIN_DB_DATABASE_URL="postgres://USER:PASSWORD@pooled.db.prisma.io:5432/postgres?sslmode=require"
OW_MAIN_DB_POSTGRES_URL=""
OW_MAIN_DB_PRISMA_DATABASE_URL=""

# Back-office sessions
# Use a separate random secret of at least 32 characters in every environment.
ORBW_AUTH_SECRET="replace-with-a-random-secret-of-at-least-32-characters"
